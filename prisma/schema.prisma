// Profintal Savings banking prototype — PostgreSQL via Prisma (Neon / Vercel
// Postgres). Status/role/tone fields are plain strings validated at the
// application layer rather than native enums.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// People — customers, the platform admin, and the other platform users that
// show up in the admin console and as recipient targets.
// ---------------------------------------------------------------------------
model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String // plaintext — mock auth only, never real security
  role      String // "CUSTOMER" | "ADMIN"
  name      String
  handle    String? // e.g. "@john_doe"
  avatar    String? // e.g. "/avatars/john.png"
  title     String? // e.g. "Primary Administrator"

  // KYC / directory attributes (surfaced in the admin users + kyc screens)
  country      String? // flag emoji, e.g. "🇺🇸"
  tier         String? // "Tier 3"
  tierTone     String? // badge tone key
  kycStatus    String? // "Verified" | "Pending" | "Frozen" | "Rejected"
  kycStatusTone String?
  riskScore    Int?
  flagged      Boolean @default(false)
  joined       DateTime @default(now())

  wallets      Wallet[]
  transactions Transaction[]
  recipients   Recipient[]
  cards        Card[]
  devices      Device[]
  settings     UserSettings?
  kyc          KycApplication?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------
model Wallet {
  id          String  @id @default(cuid())
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  currency    String // "USD"
  symbol      String // "$", "€", "£", "₦"
  balance     Float
  available   Float?
  pending     Float?
  changeLabel String? // "+0.04%" | "Stable"
  changeTone  String? // "up" | "down" | "flat"
  primary     Boolean @default(false)
  sort        Int     @default(0)

  // Receiving details (shown on the wallets screen for the primary wallet)
  accountHolder String?
  accountNumber String?
  achRouting    String?
  wireRouting   String?
  bankName      String?
  bankAddress   String?
  swift         String?
}

model Transaction {
  id       String  @id @default(cuid())
  ref      String  @unique // "TXN-2026-00847"
  owner    User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
  date     DateTime
  kind     String // "send" | "receive" | "convert" | "wire" | "ach"
  title    String
  sub      String
  currency String
  amount   Float // signed; negative = outflow
  fee      Float  @default(0)
  status   String // "Completed" | "Processing" | "Pending" | "Failed"

  // Admin ledger view + detail drawer
  party     String?
  partySub  String?
  route     String? // "Internal" | "SWIFT Wire" | "ACH" | "FX Swap"
  risk      String? // "Low" | "Medium" | "High"
  flagged   Boolean @default(false)
  reference String? // "#VLT-8849-01"
  walletSource String?
  delivery  String?

  createdAt DateTime @default(now())
}

model Recipient {
  id       String  @id @default(cuid())
  owner    User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String
  type     String // "USER" | "BANK"
  name     String
  handle   String?
  avatar   String?
  favorite Boolean @default(false)
  lastSent DateTime?

  // BANK type
  flag        String?
  bankName    String?
  accountMask String? // "****4521"

  createdAt DateTime @default(now())
}

model Card {
  id      String  @id @default(cuid())
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
  name    String // "Vault Premium"
  brand   String // "AMEX"
  last4   String // "1005"
  holder  String
  expiry  String // "12/30"
  spent   Float
  limit   Float
  frozen  Boolean @default(false)

  authorizations CardAuthorization[]
}

model CardAuthorization {
  id       String @id @default(cuid())
  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId   String
  merchant String
  category String
  when     String // display string, e.g. "Today, 10:15 AM"
  amount   Float
  sort     Int    @default(0)
}

model Device {
  id      String  @id @default(cuid())
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
  kind    String // "laptop" | "phone" | "tablet"
  name    String
  meta    String
  current Boolean @default(false)
  sort    Int     @default(0)
}

model UserSettings {
  id      String @id @default(cuid())
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String @unique

  twoFactor          Boolean @default(true)
  loginNotifications Boolean @default(true)
  txnAlerts          Boolean @default(true)
  securityLog        Boolean @default(true)
  marketing          Boolean @default(false)
  fxTriggers         Boolean @default(true)

  dailyUsed    Float @default(0)
  dailyLimit   Float @default(50000)
  monthlyUsed  Float @default(0)
  monthlyLimit Float @default(500000)
  singleCap    Float @default(10000)
}

// ---------------------------------------------------------------------------
// FX
// ---------------------------------------------------------------------------
model FxRate {
  id    String @id @default(cuid())
  base  String // "USD"
  quote String // "EUR"
  rate  Float
  change String? // "+0.12%"
  changeTone String? // "up" | "down" | "flat"
  spread String? // admin markup label
  sort  Int    @default(0)

  @@unique([base, quote])
}

// ---------------------------------------------------------------------------
// Admin — KYC, transfers, risk, fees, and dashboard widgets
// ---------------------------------------------------------------------------
model KycApplication {
  id        String @id @default(cuid())
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String @unique
  requesting String // "Tier 2 → 3"
  docs      String  // e.g. "3 documents"
  submitted String  // display date
  risk      Int
  riskTone  String
  status    String // "pending" | "escalated" | "approved" | "rejected"
  escalated Boolean @default(false)

  documents KycDocument[]
  createdAt DateTime @default(now())
}

model KycDocument {
  id      String @id @default(cuid())
  app     KycApplication @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId   String
  label   String
  status  String // "Verified" | "Pending" | "Cleared"
  sort    Int    @default(0)
}

model Transfer {
  id       String @id @default(cuid())
  ref      String @unique // "TRF-2026-0472"
  party    String
  partySub String?
  route    String
  amount   Float
  status   String // "Pending" | "Authorized" | "Rejected" | "Processing"
  risk     String?
  submitted String
  createdAt DateTime @default(now())
}

model RiskFlag {
  id         String @id @default(cuid())
  account    String
  accountSub String
  trigger    String
  score      Int
  amount     Float
  when       String
  critical   Boolean @default(false)
  status     String  @default("Open")
  createdAt  DateTime @default(now())
}

model DetectionRule {
  id      String  @id @default(cuid())
  label   String
  desc    String
  enabled Boolean @default(true)
  sort    Int     @default(0)
}

model Fee {
  id       String @id @default(cuid())
  name     String
  category String
  detail   String
  amount   String // display, e.g. "0.25%" or "$15.00"
  tier     String?
  sort     Int    @default(0)
}

model Alert {
  id       String @id @default(cuid())
  severity String // "critical" | "medium" | "warning" | "notice"
  title    String
  detail   String
  when     String
  sort     Int    @default(0)
}

model Gateway {
  id     String @id @default(cuid())
  name   String
  status String // "Operational" | "Healthy" | "Degraded"
  tone   String
  sort   Int    @default(0)
}

// Support chat messages left by customers. Stored here and (when SMTP is
// configured) emailed to the owner.
model SupportMessage {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
