# Copy this file to `.env` and fill in your own values.

# PostgreSQL (Supabase, Neon, or Vercel Postgres).
#  - DATABASE_URL: pooled connection used by the app at runtime
#  - DIRECT_URL:   direct connection used by `prisma db push` / migrations
# On Supabase these are the "Transaction" (port 6543, add ?pgbouncer=true) and
# "Session" (port 5432) pooler strings. Remove the [ ] around the password.
DATABASE_URL="postgresql://postgres.<ref>:<kXCq8yxZxU9p91WS>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<kXCq8yxZxU9p91WS>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Optional: support-chat email notifications (nodemailer). Leave unset to
# disable email (messages still save to the database).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-app-password"
# SUPPORT_EMAIL="you@example.com"
