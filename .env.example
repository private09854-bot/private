# Copy this file to `.env` and fill in your own values.
# Supabase is used for BOTH auth and data — only the API keys are needed.
# Get them from: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# "anon / public" key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# "service_role" key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Optional: support-chat email notifications (nodemailer). Leave unset to
# disable email (messages still save to the database).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-app-password"
# SUPPORT_EMAIL="you@example.com"
