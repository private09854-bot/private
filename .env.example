# Copy this file to `.env` and replace the ALL-CAPS placeholders with your own
# values. Never put real credentials in this file — it is committed to git.

# PostgreSQL (Supabase, Neon, or Vercel Postgres).
#  - DATABASE_URL: pooled connection used by the app at runtime
#  - DIRECT_URL:   direct connection used by `prisma db push` / migrations
# On Supabase these are the "Transaction" (port 6543) and "Session" (port 5432)
# pooler strings. Paste the password plainly — no [ ] or < > around it.
DATABASE_URL="postgresql://postgres.PROJECT_REF:kXCq8yxZxU9p91WS@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:kXCq8yxZxU9p91WS@aws-1-REGION.pooler.supabase.com:5432/postgres"

# Optional: support-chat email notifications (nodemailer). Leave unset to
# disable email (messages still save to the database).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-app-password"
# SUPPORT_EMAIL="you@example.com"
